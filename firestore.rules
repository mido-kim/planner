rules_version = '2';

// Each signed-in account can read and write only its own data, stored under
// users/{its uid}/. Paste this into Firebase console → Firestore → Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
